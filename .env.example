# Subnet Whisperer configuration
#
# Copy to .env and adjust. docker compose reads .env automatically.
# The app itself does NOT load .env; when running outside Docker, export it first:
#   set -a; . ./.env; set +a
# An empty value is treated the same as "not set".

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# Fernet key used to encrypt stored SSH passwords, private keys and sudo passwords.
# Must be a valid Fernet key (32 url-safe base64-encoded bytes), otherwise the app
# refuses to start. Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, the app uses instance/.encryption_key, creating it (mode 600) on first start.
# Whichever you use, KEEP AND BACK IT UP: losing or changing it makes stored
# credentials undecryptable.
#ENCRYPTION_KEY=

# Legacy only: if ENCRYPTION_KEY is unset and instance/.encryption_key does not
# exist, the encryption key is derived from FLASK_SECRET_KEY (or SECRET_KEY) and a
# warning is logged. Set this only if an existing install was deployed with it
# (for example the old docker-compose default) and you need to read old credentials.
#FLASK_SECRET_KEY=

# Flask session signing secret. If unset, one is generated and stored in
# instance/.secret_key. Changing it logs everyone out.
#SESSION_SECRET=

# Password for the initial "admin" account, used only when the database is first
# created. If unset, a random password is generated, logged once at WARNING level
# and written to instance/initial_admin_password. A password change is forced at
# first login. Minimum length: 8.
#ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# SQLAlchemy URL. Default: sqlite:///instance/subnet_whisperer.db
# (Ignored by the web-postgres compose service, which builds it from POSTGRES_*.)
#DATABASE_URL=postgresql://username:password@host:5432/dbname

# PostgreSQL container settings (docker compose --profile postgres).
# POSTGRES_PASSWORD is required for the postgres profile. Use a value without
# URL-special characters (@ : / ? #), because it is placed into DATABASE_URL as-is.
#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=
#POSTGRES_DB=subnet_whisperer

# ---------------------------------------------------------------------------
# Web server (python3 main.py only; the Docker image always runs gunicorn on 0.0.0.0:5000)
# ---------------------------------------------------------------------------

# Enable the Flask/Werkzeug debugger. Never enable on a reachable interface.
#FLASK_DEBUG=false
# Bind address for main.py. Default: 127.0.0.1
#FLASK_HOST=127.0.0.1
# Port for main.py. Default: 5000
# On macOS, port 5000 is used by AirPlay Receiver; pick another one (e.g. 5050).
#PORT=5000

# Host port that docker compose publishes the app on. Default: 5000
#HOST_PORT=5000

# Send the session cookie only over HTTPS. Set to true behind TLS. Default: false
#SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Scanning
# ---------------------------------------------------------------------------

# Command filter mode (a best-effort guardrail, not a security boundary).
#   enabled  (default): also blocks shell operators (; && || & | > < ` $( ${ newline)
#                       and restricted commands such as systemctl, chmod, useradd
#   disabled: only the always-blocked destructive commands are rejected
#COMMAND_SANITIZATION=enabled

# SSH host key policy:
#   tofu   (default): trust on first use; record new keys, reject changed keys
#   reject: only connect to hosts already in known_hosts (system or app file)
#   warn:   accept any key and record nothing (legacy, insecure)
#SSH_HOST_KEY_POLICY=tofu
# Known-hosts file used by the app. Default: instance/known_hosts
#SSH_KNOWN_HOSTS_FILE=instance/known_hosts
# Per-command execution timeout in seconds. Default: 60
#SSH_COMMAND_TIMEOUT=60
# SSH connect/banner/auth timeout in seconds. Default: 10
#SSH_CONNECT_TIMEOUT=10
# Maximum bytes kept per output stream (stdout/stderr) per command. Default: 1048576
#SSH_MAX_OUTPUT_BYTES=1048576

# Maximum number of IP addresses in a single scan. Default: 65536
#MAX_SCAN_IPS=65536
# Maximum concurrent connections per scan (minimum 1). Default: 100
#MAX_CONCURRENCY=100

# Background scheduler for scheduled scans. Set to false to disable
# (tests do this). Default: true
#START_SCHEDULER=true

# ---------------------------------------------------------------------------
# Docker
# ---------------------------------------------------------------------------
#COMPOSE_PROJECT_NAME=subnet-whisperer
